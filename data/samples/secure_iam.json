{
    "resource_type": "iam",
    "resource_name": "demo-readonly-policy",
    "policy": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:ListBucket"
                ],
                "Resource": "arn:aws:s3:::my-bucket/*"
            }
        ]
    }
}
