{
    "resource_type": "iam",
    "resource_name": "demo-admin-wildcard-policy",
    "policy": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": "*",
                "Resource": "*"
            },
            {
                "Effect": "Allow",
                "Action": [
                    "s3:*",
                    "iam:*",
                    "ec2:*"
                ],
                "Resource": "*"
            },
            {
                "Effect": "Allow",
                "Action": [
                    "iam:AttachUserPolicy",
                    "iam:PassRole"
                ],
                "Resource": "*"
            }
        ]
    }
}
